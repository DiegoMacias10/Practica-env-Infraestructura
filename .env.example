# Variables de entorno para el frontend  
  
# Mostrar/ocultar placeholders en los campos del formulario  
# Valores posibles: 'true' o 'false'  
VITE_SHOW_PLACEHOLDERS=true  
  
# URL del servidor backend para las peticiones de autenticacion  
# Por defecto: http://localhost:3000/login  
VITE_SERVER_URL=http://localhost:3000/login 
